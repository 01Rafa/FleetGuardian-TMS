DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"
DB_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
JWT_SECRET=change_me_32chars_minimum_secret_key
JWT_REFRESH_SECRET=change_me_different_32chars_secret2
PORT=3000
# Which environment this process is: development, staging or production.
# The database must carry the same marker (see docs/entornos.md), otherwise the server refuses to start.
APP_ENV=development
FRONTEND_URL=https://your-frontend.vercel.app
# Exact browser origins allowed to call the API with cookies (comma separated, no wildcards).
# FRONTEND_URL is also allowed. Every other origin, including other *.vercel.app sites, is blocked.
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ORS_API_KEY=your_openrouteservice_api_key_here
